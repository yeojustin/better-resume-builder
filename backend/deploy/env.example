# Copy to `deploy/.env` for Docker Compose variable substitution only.
# Do not commit `deploy/.env` with real keys (root `.gitignore` already ignores `.env*`).

GEMINI_API_KEY=

# Optional: comma-separated browser origins for CORS (gateway / embedded).
# Leave empty to allow all origins (simplest for local Docker).
# ALLOWED_ORIGINS=https://your-frontend.example,https://www.your-frontend.example
