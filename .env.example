# Example environment for LOCAL development only. Copy to `.env` at the
# repository root OR to `backend/.env` (both are loaded in development).
# Do not commit a real `.env` file.

# -----------------------------------------------------------------------------
# Option A — Default: use the in-app “session” Gemini key (browser only).
# Leave the lines below commented out. Start backend + frontend as in README.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Option B — Put the Gemini key in .env (server-side for this machine).
# Uncomment and set:
# -----------------------------------------------------------------------------
# GEMINI_SESSION_ONLY=false
# GEMINI_API_KEY=your-google-ai-studio-key

# Optional: use GOOGLE_API_KEY instead of GEMINI_API_KEY (either works).
# GOOGLE_API_KEY=

# Frontend: skip the first-run “add key” modal when using Option B:
#   VITE_SKIP_GEMINI_KEY_GATE=true npm run dev
# (Or paste the same key in the modal — the server will still use .env if set.)
